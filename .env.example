# =============================================================================
# Google OAuth 2.0 Python Backend Configuration Blueprint (.env.example)
# =============================================================================
# Security Notice:
# 1. Never commit the actual '.env' file to source control.
# 2. Keep GOOGLE_CLIENT_SECRET and JWT_SECRET strictly isolated in Secret Managers
#    when deploying to production (e.g., GCP Secret Manager, AWS Secrets Manager).
# =============================================================================

# Server Environment & Port
ENVIRONMENT=development
PORT=5000
HOST=0.0.0.0

# Google OAuth 2.0 Credentials (From Google Cloud Console: APIs & Services > Credentials)
# Client ID identifies your application to Google OAuth authorization servers
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Client Secret is optional for ID Token verification, but required for code exchange
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Optional: Restrict logins to a specific Google Workspace hosted domain (e.g., example.com)
# Leave blank to allow any verified Google account
RESTRICTED_HOSTED_DOMAIN=

# Custom JWT Session Security Configuration
# Generate a cryptographically secure 256-bit random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=super_secret_cryptographically_secure_jwt_key_min_32_characters_long
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# CORS Allowed Origin (Address of your frontend client, e.g. Angular on port 4200)
ALLOWED_ORIGIN=http://localhost:4200

# Rate Limiting Configuration (Mitigates brute-force authentication attacks)
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_GLOBAL=100/minute
